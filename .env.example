# Confirmed production origin: https://www.mozzaitalia.com
# Set this at build AND runtime for production; do not use a preview/localhost URL.
NEXT_PUBLIC_SITE_URL=
# Non-Vercel production requires SEO_ENV=production. For a local `next build`
# or private preview use SEO_ENV=preview. Vercel's VERCEL_ENV takes precedence;
# remove this preview setting or change it to production on a production deployment.
SEO_ENV=preview
# Optional Search Console HTML-tag verification token (the content value only).
GOOGLE_SITE_VERIFICATION=
# Public restaurant destination; only read by the server. The website fallback is centralized in restaurant.ts.
WHATSAPP_PHONE_NUMBER=919949799488
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
# Meta app secret used to verify X-Hub-Signature-256 (different from verify token).
WHATSAPP_APP_SECRET=
# Select a currently supported version in your Meta app, including the leading v.
WHATSAPP_API_VERSION=
SUPABASE_URL=
# Reserved for future auth; currently unused. All data operations use the server service role.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Random secret of at least 32 characters. Never use NEXT_PUBLIC_ for any secret.
ADMIN_ORDER_SECRET=
# Optional approved utility template. Body variables: {{1}} order reference, {{2}} status.
WHATSAPP_STATUS_TEMPLATE_NAME=
WHATSAPP_STATUS_TEMPLATE_LANGUAGE=

# Local staff login only (ignored in production). Set test/test in .env.local.
ADMIN_TEST_USERNAME=
ADMIN_TEST_PASSWORD=
# Production staff login: password must be at least 16 characters; test credentials are rejected.
ADMIN_USERNAME=
ADMIN_PASSWORD=
